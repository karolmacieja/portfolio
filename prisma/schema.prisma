// Models are added in the phase that introduces them (see SPEC.md / CLAUDE.md).
// Phase 0: identity, roles, audit, settings. Phase 1: sites, pages, domains.
// Phase 2: theme, SEO, page versions, media assets. Phase 3: plans, prices, subscriptions, block access.
// Phase 4: templates, template versions/overrides/purchases, site backups.
// Phase 5: billing profiles, payments, webhook events, coupons, dunning fields.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  SUPPORT
  ADMIN
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  // Null for users who only sign in via magic link or OAuth.
  passwordHash        String?
  /// Sessions (JWTs) issued before this moment are ended (password change/reset).
  passwordChangedAt   DateTime?
  role                Role      @default(CLIENT)
  locale              String    @default("pl")
  blockedAt           DateTime?
  /// Customer id at the payment provider (Stripe customer / mock).
  billingCustomerId   String?   @unique
  /// Version label of the terms of service accepted at registration (or later), with the time.
  termsVersion        String?
  termsAcceptedAt     DateTime?
  /// Account deletion requested by the client (RODO); data is erased after the grace period.
  deletionScheduledAt DateTime?
  /// Set when personal data was erased; the row stays (anonymized) for invoices and payments.
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  auditLogs            AuditLog[]             @relation("AuditActor")
  clientNotes          ClientNote[]           @relation("NoteClient")
  authoredNotes        ClientNote[]           @relation("NoteAuthor")
  impersonations       ImpersonationSession[] @relation("ImpersonatedUser")
  impersonating        ImpersonationSession[] @relation("Impersonator")
  managedOrganizations Organization[]         @relation("OrganizationManager")
  membership           OrganizationMember?
  sponsorRemoval       SponsorRemoval?
  sites                Site[]
  assets               Asset[]
  subscriptions        Subscription[]
  templateOverrides    TemplateOverride[]
  templatePurchases    TemplatePurchase[]
  billingProfile       BillingProfile?
  payments             Payment[]
  invoices             Invoice[]
  domainOrders         DomainOrder[]

  @@index([role])
}

// Auth.js models (field names dictated by @auth/prisma-adapter).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Unused while the JWT session strategy is active; kept so the adapter contract is complete.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id         String   @id @default(cuid())
  // Null for system-initiated actions (jobs, webhooks).
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Key/value store for admin-editable settings (grace period, domain margin, company data, ...).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum SiteStatus {
  ACTIVE
  // Content replaced by a notice (unpaid subscription, moderation).
  SUSPENDED
}

enum SuspensionReason {
  PAYMENT
  MODERATION
}

/// A client's portfolio website, served at {slug}.{ROOT_DOMAIN} and on its connected domains.
model Site {
  id                String            @id @default(cuid())
  ownerId           String
  name              String
  /// Subdomain label; unique platform-wide, validated against reserved slugs.
  slug              String            @unique
  /// Language of the published site (system messages, <html lang>).
  locale            String            @default("pl")
  status            SiteStatus        @default(ACTIVE)
  suspensionReason  SuspensionReason?
  /// Statement of reasons shown to the owner for moderation suspensions (DSA).
  suspensionNote    String?
  suspendedAt       DateTime?
  /// Null until the first publication; unpublished sites are not served.
  publishedAt       DateTime?
  /// Default meta description for pages without their own.
  description       String?
  /// Asks search engines not to index the site (robots.txt + meta robots).
  noIndex           Boolean           @default(false)
  faviconUrl        String?
  /// Theme being edited (src/themes/theme.ts); copied to themePublished on publish. Null = default theme.
  themeDraft        Json?
  themePublished    Json?
  /// Template the site was created from / last switched to (statistics, upgrades).
  templateId        String?
  templateVersionId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages           Page[]
  domains         Domain[]
  domainOrders    DomainOrder[]
  abuseReports    AbuseReport[]
  backups         SiteBackup[]
  contactMessages ContactMessage[]
  dailyStats      SiteDailyStat[]
  dailyVisitors   SiteDailyVisitor[]
  dailyUniques    SiteDailyUnique[]
  template        Template?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion TemplateVersion?   @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

/// One page of a site. Content is Puck JSON; editing always happens on the draft.
model Page {
  id               String    @id @default(cuid())
  siteId           String
  /// URL path without leading slash; "" is the home page.
  path             String
  title            String
  position         Int       @default(0)
  draftContent     Json
  /// Copy of draftContent made on publish; null = never published (not served).
  publishedContent Json?
  publishedAt      DateTime?
  /// When the draft content was last saved; compared with publishedAt for "unpublished changes".
  draftUpdatedAt   DateTime  @default(now())
  /// SEO metadata is applied immediately (not part of draft/publish).
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  /// Template lock rules per block id: { [blockId]: { edit?: false, drag?: false, delete?: false } }.
  lockRules        Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  versions PageVersion[]

  @@unique([siteId, path])
  @@index([siteId, position])
}

enum DomainType {
  SUBDOMAIN
  CONNECTED
  PURCHASED
}

/// DISABLED: switched off because the owner's plan no longer includes custom domains (re-enable after upgrading).
enum DomainStatus {
  PENDING_DNS
  PENDING_SSL
  ACTIVE
  ERROR
  DISABLED
}

/// Custom domains attached to a site (hostnames served through Cloudflare for SaaS). Platform subdomains are
/// derived from Site.slug and need no row. When a site has an ACTIVE primary domain, every other host of the
/// site (subdomain, other domains) redirects to it.
model Domain {
  id                 String       @id @default(cuid())
  siteId             String
  /// Lowercase ASCII (punycode) hostname without port, e.g. "www.jan-kowalski.pl".
  hostname           String       @unique
  type               DomainType   @default(CONNECTED)
  status             DomainStatus @default(PENDING_DNS)
  isPrimary          Boolean      @default(false)
  /// Custom hostname id at the hostname provider (Cloudflare); null when not registered there (DISABLED).
  providerHostnameId String?      @unique
  /// Provider SSL status (e.g. "pending_validation", "active"), shown to staff.
  sslStatus          String?
  /// DNS records the client has to create: [{ type, name, value, purpose }].
  dnsRecords         Json?
  lastError          String?
  checkedAt          DateTime?
  activatedAt        DateTime?
  /// Set when the owner's plan lost customDomain; the domain is disabled after the grace period.
  entitlementLostAt  DateTime?
  /// Purchased domains: the order (registration) they come from.
  orderId            String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  site  Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  order DomainOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([status, checkedAt])
}

/// PENDING_PAYMENT -> (paid) REGISTERING -> ACTIVE; FAILED needs staff; EXPIRED after expiresAt without renewal;
/// CANCELED: checkout abandoned.
enum DomainOrderStatus {
  PENDING_PAYMENT
  REGISTERING
  ACTIVE
  FAILED
  EXPIRED
  CANCELED
}

/// A domain bought through the platform (registrar: Openprovider). Paid by a yearly provider subscription
/// (Stripe) that renews it; the domain belongs to the client even without a plan.
model DomainOrder {
  id                     String            @id @default(cuid())
  userId                 String
  /// Site the domain is connected to after registration (may be changed or removed later).
  siteId                 String?
  /// ASCII domain name, e.g. "jan-kowalski.pl".
  domainName             String
  status                 DomainOrderStatus @default(PENDING_PAYMENT)
  /// Yearly gross price charged to the client, in grosze.
  priceAmount            Int
  currency               String            @default("PLN")
  /// Registrar price at order time (minor units of registrarCurrency), for margin reporting.
  registrarCost          Int?
  registrarCurrency      String?
  /// Registrant (abonent) data given by the client: type, names, address, email, phone, tax id.
  registrant             Json
  registrarHandle        String?
  registrarDomainId      String?
  expiresAt              DateTime?
  autoRenew              Boolean           @default(true)
  providerSubscriptionId String?           @unique
  /// Renewal reminders already sent for the current period (days before expiry, e.g. [30, 7]).
  remindersSent          Int[]             @default([])
  lastRenewedAt          DateTime?
  attempts               Int               @default(0)
  lastError              String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  site     Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  domains  Domain[]
  payments Payment[]

  @@index([userId])
  @@index([domainName])
  @@index([status, expiresAt])
}

/// Snapshot of a page's content taken on every publish (the last N are kept). Restoring copies it into the draft.
model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  /// Sequential per page, starting at 1.
  number      Int
  title       String
  content     Json
  createdById String?
  createdAt   DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, number])
}

/// Uploaded media file (optimized image) in object storage, owned by a client.
model Asset {
  id           String   @id @default(cuid())
  ownerId      String
  /// Object key of the optimized file; the thumbnail lives at `{key}` with a `-thumb` suffix.
  key          String   @unique
  url          String
  thumbUrl     String
  contentType  String
  /// Bytes of the stored files (optimized + thumbnail); counted against the storage quota.
  sizeBytes    Int
  width        Int?
  height       Int?
  originalName String
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

enum BillingInterval {
  MONTH
  YEAR
}

/// Subscription plan. Editable by admins (no hard-coded plans); see src/server/entitlements.
model Plan {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  /// Order on the pricing page; the first active plan also defines limits for users without a subscription.
  position         Int      @default(0)
  /// Inactive plans are hidden and cannot be bought; existing subscribers keep them.
  isActive         Boolean  @default(true)
  trialDays        Int      @default(14)
  maxSites         Int
  maxPagesPerSite  Int
  /// Null = unlimited.
  maxProjects      Int?
  storageMb        Int
  /// Feature flags, validated by `planFeaturesSchema` (missing = disabled).
  features         Json     @default("{}")
  /// Access tiers for blocks and templates, e.g. ["basic", "pro"].
  accessTiers      String[]
  /// Gross price per seat of a group license (grosze); null = not offered for self-service licenses.
  seatPriceMonthly Int?
  seatPriceYearly  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prices            PlanPrice[]
  subscriptions     Subscription[]
  templateOverrides TemplateOverride[]
  organizations     Organization[]
}

model PlanPrice {
  id            String          @id @default(cuid())
  planId        String
  interval      BillingInterval
  /// Gross amount in the smallest currency unit (grosze), VAT included.
  amount        Int
  currency      String          @default("PLN")
  /// Linked Stripe Price (Phase 5).
  stripePriceId String?         @unique
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  /// One active price per plan/interval/currency (enforced by the admin service); changed amounts get a new row.
  @@index([planId, interval, currency])
}

/// Mirrors Stripe subscription statuses.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  CANCELED
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  priceId                String?
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  /// Subscription id at the payment provider; null for subscriptions granted manually (seed, admin).
  providerSubscriptionId String?            @unique
  /// Set on the first failed payment, cleared when paid; drives dunning (src/server/billing/dunning.ts).
  pastDueSince           DateTime?
  /// Dunning reminders already sent for the current past-due period; -1 once sites were suspended.
  dunningStage           Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan       @relation(fields: [planId], references: [id])
  price    PlanPrice? @relation(fields: [priceId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId, status])
}

/// Required access tier per block type; rows override the defaults in src/server/entitlements/rules.ts.
model BlockAccess {
  blockType    String   @id
  requiredTier String
  updatedAt    DateTime @updatedAt
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Site template authored by admins. `draft` is the working copy; publishing snapshots it into a TemplateVersion.
model Template {
  id                 String         @id @default(cuid())
  slug               String         @unique
  name               String
  description        String?
  category           String
  tags               String[]
  /// Access tier required to use the template (see src/server/entitlements).
  accessTier         String         @default("basic")
  status             TemplateStatus @default(DRAFT)
  thumbnailUrl       String?
  position           Int            @default(0)
  isNew              Boolean        @default(false)
  isFeatured         Boolean        @default(false)
  /// One-time purchase (Stripe Checkout, Phase 5) in addition to the tier.
  isPremium          Boolean        @default(false)
  /// Gross price in grosze for premium templates.
  priceAmount        Int?
  /// Working copy: { pages: [{ key, path, title, content, lockRules }], theme } (src/server/templates/schema.ts).
  draft              Json
  publishedVersionId String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  publishedVersion TemplateVersion?   @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         TemplateVersion[]
  overrides        TemplateOverride[]
  purchases        TemplatePurchase[]
  sites            Site[]

  @@index([status, position])
}

model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  number      Int
  /// [{ key, path, title, content, lockRules }]
  pages       Json
  theme       Json
  createdById String?
  createdAt   DateTime @default(now())

  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  publishedOf Template? @relation("PublishedVersion")
  sites       Site[]

  @@unique([templateId, number])
}

/// Grants access to a template beyond its tier, for a whole plan or a single user.
model TemplateOverride {
  id         String   @id @default(cuid())
  templateId String
  planId     String?
  userId     String?
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  plan     Plan?    @relation(fields: [planId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// One-time purchase of a premium template (Stripe Checkout, Phase 5).
model TemplatePurchase {
  id                String   @id @default(cuid())
  templateId        String
  userId            String
  amount            Int
  currency          String   @default("PLN")
  /// Checkout session id at the payment provider.
  providerSessionId String?  @unique
  createdAt         DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
}

/// Full snapshot of a site (pages + theme) taken before destructive changes such as switching templates.
model SiteBackup {
  id          String   @id @default(cuid())
  siteId      String
  reason      String
  /// { pages: [{ path, title, position, draftContent, publishedContent, seo..., lockRules }], themeDraft, templateId, templateVersionId }
  data        Json
  createdById String?
  createdAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

enum BillingPartyType {
  PERSON
  COMPANY
}

/// Invoice details collected before purchase (Phase 6 issues VAT invoices from them).
model BillingProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  type            BillingPartyType
  /// Person's name, or contact name for companies.
  fullName        String
  companyName     String?
  /// Polish NIP (10 digits, no separators) for Polish companies.
  taxId           String?
  /// EU VAT id with country prefix (e.g. DE123456789) for EU companies outside Poland.
  euVatId         String?
  /// Intra-EU B2B reverse charge applies (verified EU VAT id outside PL); used by invoicing.
  reverseCharge   Boolean          @default(false)
  taxIdVerifiedAt DateTime?
  line1           String
  line2           String?
  postalCode      String
  city            String
  country         String           @default("PL")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentKind {
  SUBSCRIPTION
  TEMPLATE
  DOMAIN
  LICENSE
  ADDON
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED
}

/// A charge at the payment provider (subscription invoice or one-time purchase); invoiced via Invoice.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  subscriptionId    String?
  kind              PaymentKind
  status            PaymentStatus
  /// Gross amount in grosze.
  amount            Int
  currency          String        @default("PLN")
  /// Provider invoice id (subscriptions) or checkout session id (one-time purchases).
  providerPaymentId String        @unique
  description       String
  /// Billing profile at the time of payment (for the invoice).
  billingSnapshot   Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  /// Provider charge reference (Stripe PaymentIntent id); refunds are matched by it.
  providerChargeRef String? @unique
  /// Cumulative refunded amount in grosze (partial refunds keep status PAID).
  refundedAmount    Int     @default(0)
  /// Domain registration/renewal payments.
  domainOrderId     String?
  /// Group license payments.
  organizationId    String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  domainOrder  DomainOrder?  @relation(fields: [domainOrderId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  invoices     Invoice[]

  @@index([userId, createdAt])
}

enum InvoiceKind {
  INVOICE
  CORRECTION
}

/// PENDING: waiting for the worker; ISSUED: created at the invoicing provider; FAILED: retries exhausted,
/// needs manual review in the admin panel.
enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
}

enum KsefStatus {
  NOT_SENT
  PROCESSING
  ACCEPTED
  ERROR
  NOT_APPLICABLE
}

/// VAT invoice (or correction) for a payment, issued by the invoicing provider (Fakturownia / mock).
/// Amounts in grosze; negative for corrections. Buyer and seller are snapshots taken at creation.
model Invoice {
  id                 String        @id @default(cuid())
  userId             String
  paymentId          String
  kind               InvoiceKind
  /// For corrections: the corrected invoice.
  correctedInvoiceId String?
  /// One invoice per payment, one correction per refunded total (see billing/invoices).
  idempotencyKey     String        @unique
  status             InvoiceStatus @default(PENDING)
  number             String?
  providerInvoiceId  String?
  issueDate          DateTime?
  sellDate           DateTime
  currency           String        @default("PLN")
  /// "23", "8", "5", "0", "zw" (exempt) or "np" (reverse charge, outside Polish VAT).
  vatRate            String
  netAmount          Int
  vatAmount          Int
  grossAmount        Int
  reverseCharge      Boolean       @default(false)
  positionName       String
  buyer              Json
  seller             Json
  ksefStatus         KsefStatus    @default(NOT_SENT)
  ksefNumber         String?
  ksefError          String?
  attempts           Int           @default(0)
  lastError          String?
  emailedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment          Payment          @relation(fields: [paymentId], references: [id], onDelete: NoAction)
  correctedInvoice Invoice?         @relation("InvoiceCorrections", fields: [correctedInvoiceId], references: [id], onDelete: NoAction)
  corrections      Invoice[]        @relation("InvoiceCorrections")
  document         InvoiceDocument?

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([ksefStatus])
}

/// Invoice PDF, kept in the database (private, small, backed up with the data) rather than in the public bucket.
model InvoiceDocument {
  invoiceId String   @id
  content   Bytes
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// Processed webhook events (idempotency: an event id is handled at most once).
model WebhookEvent {
  id          String   @id
  provider    String
  type        String
  processedAt DateTime @default(now())
}

enum CouponDuration {
  ONCE
  REPEATING
  FOREVER
}

/// Discount code, managed by admins and synced to the payment provider.
model Coupon {
  id                      String         @id @default(cuid())
  /// Code entered by clients (uppercase).
  code                    String         @unique
  name                    String
  percentOff              Int?
  /// Fixed discount in grosze (PLN).
  amountOff               Int?
  duration                CouponDuration @default(ONCE)
  durationInMonths        Int?
  maxRedemptions          Int?
  timesRedeemed           Int            @default(0)
  expiresAt               DateTime?
  isActive                Boolean        @default(true)
  providerCouponId        String?
  providerPromotionCodeId String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

/// Internal staff notes about a client (never shown to the client).
model ClientNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  user   User  @relation("NoteClient", fields: [userId], references: [id], onDelete: Cascade)
  author User? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Staff signed in as a client. The token that starts it is single-use (usedAt); sessions expire at expiresAt
/// and can be ended early (endedAt). Every session is audited.
model ImpersonationSession {
  id        String    @id @default(cuid())
  adminId   String
  userId    String
  reason    String
  expiresAt DateTime
  usedAt    DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  admin User @relation("Impersonator", fields: [adminId], references: [id], onDelete: Cascade)
  user  User @relation("ImpersonatedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AbuseCategory {
  ILLEGAL
  COPYRIGHT
  PRIVACY
  FRAUD
  HATE
  OTHER
}

enum AbuseReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/// "Report content" submissions from public sites (DSA notice and action). The reporter's email is optional.
model AbuseReport {
  id            String            @id @default(cuid())
  siteId        String
  /// Page path the report is about.
  path          String
  category      AbuseCategory
  description   String
  reporterEmail String?
  /// Salted hash of the reporter's IP (rate limiting / abuse of the form), never the IP itself.
  reporterHash  String?
  status        AbuseReportStatus @default(OPEN)
  /// Decision and statement of reasons (sent to the reporter and, when actioned, to the site owner).
  resolution    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([siteId])
}

/// Message sent through a ContactForm block on a published site.
model ContactMessage {
  id         String    @id @default(cuid())
  siteId     String
  /// Page path the form was on.
  path       String
  name       String
  email      String
  message    String
  /// Salted hash of the sender's IP (rate limiting), never the IP itself.
  senderHash String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

/// Page views per site, day and path (cookie-less counter).
model SiteDailyStat {
  siteId String
  day    DateTime @db.Date
  path   String
  views  Int      @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, path])
}

/// Visitor hashes of the current day (daily salt; not linkable across days). Rolled up into
/// SiteDailyUnique and deleted by the worker.
model SiteDailyVisitor {
  siteId String
  day    DateTime @db.Date
  hash   String

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, hash])
  @@index([day])
}

model SiteDailyUnique {
  siteId   String
  day      DateTime @db.Date
  visitors Int

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day])
}

enum LicenseSource {
  /// Bought in the panel: a provider subscription with one unit per seat.
  STRIPE
  /// Created by staff for an agreed price (invoiced outside the payment provider).
  MANUAL
}

enum LicenseStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum OrganizationRole {
  MANAGER
  MEMBER
}

/// A group license: an organization (school, agency...) with a pool of seats on one plan. Members get the
/// plan through their seat; they can still buy a higher plan or a domain themselves.
model Organization {
  id                     String           @id @default(cuid())
  name                   String
  planId                 String
  seats                  Int
  source                 LicenseSource
  status                 LicenseStatus    @default(PENDING_PAYMENT)
  /// Self-service licenses: billing interval, gross price per seat and the provider subscription.
  interval               BillingInterval?
  seatPrice              Int?
  providerSubscriptionId String?          @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  /// Manual licenses: end of the agreed period (null = until cancelled) and the staff note (agreed price...).
  validUntil             DateTime?
  note                   String?
  /// Who manages seats and invitations (and pays for self-service licenses).
  managerId              String?
  /// Footer "Strona wspierana przez {sponsorName}" on members' sites; staff can switch it off for everyone.
  sponsorName            String?
  sponsorUrl             String?
  sponsorFooter          Boolean          @default(true)
  /// Members may connect and buy domains even if the plan lacks those features (they pay for the domain).
  membersCanBuyDomains   Boolean          @default(true)
  /// Shareable join link code; the link can be switched off (then only e-mail invitations work).
  joinCode               String           @unique
  joinLinkEnabled        Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  plan     Plan                 @relation(fields: [planId], references: [id])
  manager  User?                @relation("OrganizationManager", fields: [managerId], references: [id], onDelete: SetNull)
  members  OrganizationMember[]
  invites  OrganizationInvite[]
  payments Payment[]

  @@index([status])
}

model OrganizationMember {
  id                  String           @id @default(cuid())
  organizationId      String
  /// A user belongs to at most one organization.
  userId              String           @unique
  role                OrganizationRole @default(MEMBER)
  /// Staff switched the sponsor footer off for this member.
  sponsorFooterHidden Boolean          @default(false)
  joinedAt            DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrganizationInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  /// SHA-256 of the token in the invitation link.
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

enum SponsorRemovalMode {
  MONTHLY
  ONCE
}

enum SponsorRemovalStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELED
}

/// A member paid to remove the sponsor footer from their sites (monthly add-on or one-time).
model SponsorRemoval {
  id                     String               @id @default(cuid())
  userId                 String               @unique
  mode                   SponsorRemovalMode
  status                 SponsorRemovalStatus @default(PENDING_PAYMENT)
  amount                 Int
  providerSubscriptionId String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
