# =============================================================================
# Portfolio SaaS - environment variables
# Copy to `.env` and adjust. Every variable read by the app is validated in
# src/lib/env.ts; the app refuses to start with an invalid configuration.
# All third-party integrations default to mock implementations, so the app
# runs locally without any real API keys.
# =============================================================================

# --- Platform ----------------------------------------------------------------
# Deployment stage: development | test | staging | production.
# With APP_ENV=production mock integrations (e.g. MAIL_PROVIDER=mock) are refused.
APP_ENV="development"
# Root domain of the platform, optionally with port. Hosts derived from it:
#   {ROOT_DOMAIN} / www.  -> marketing site
#   app.{ROOT_DOMAIN}     -> client panel and editor
#   admin.{ROOT_DOMAIN}   -> admin panel
#   {slug}.{ROOT_DOMAIN}  -> published client sites
# Locally `*.localhost` resolves to 127.0.0.1 in modern browsers.
ROOT_DOMAIN="localhost:3000"
# Protocol used when building absolute URLs (links in emails, redirects).
APP_PROTOCOL="http"
# Product name shown in the UI, emails and the "Made with ..." footer.
# Default service name; the admin can rename the service in admin /branding (saved name wins).
BRAND_NAME="Portfolio"

# Number of reverse proxies in front of the app (Caddy/Traefik = 1, + Cloudflare proxy = 2).
# Used to read the real client IP from X-Forwarded-For for rate limiting.
TRUSTED_PROXY_HOPS="1"

# --- Database & cache --------------------------------------------------------
# PostgreSQL connection string (docker compose: postgres service).
DATABASE_URL="postgresql://portfolio:portfolio@localhost:54320/portfolio"
# Redis: rate limiting now, BullMQ background jobs from later phases.
REDIS_URL="redis://localhost:6379"

# --- Auth (Auth.js) ----------------------------------------------------------
# Secret used to sign/encrypt session tokens. Generate: `openssl rand -base64 32`.
AUTH_SECRET="change-me-to-a-random-32+-character-secret"
# Google OAuth (optional). Google sign-in is enabled only when both are set.
# Authorized redirect URI: {APP_PROTOCOL}://app.{ROOT_DOMAIN}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email -------------------------------------------------------------------
# mock   - log emails to the console (default; refused when APP_ENV=production)
# smtp   - send through SMTP (docker compose: Mailpit, UI at http://localhost:8025)
# resend - send through Resend (production)
MAIL_PROVIDER="smtp"
# Sender address, e.g. "Portfolio <no-reply@example.com>". Must be a verified domain in Resend.
MAIL_FROM="Portfolio <no-reply@localhost>"
# SMTP settings (MAIL_PROVIDER=smtp). Mailpit needs no credentials.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
# Resend API key (MAIL_PROVIDER=resend).
RESEND_API_KEY=""

# --- Storage (uploads) -------------------------------------------------------
# local - files on disk in STORAGE_LOCAL_DIR, served at /storage/* (development; refused in production)
# s3    - any S3-compatible storage: MinIO locally (docker compose), Cloudflare R2 in production
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".storage"
# S3 settings (STORAGE_PROVIDER=s3). Values below match `docker compose --profile s3` (RustFS).
# R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto", S3_FORCE_PATH_STYLE="false"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="portfolio"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Public base URL of the bucket (R2 custom domain / local bucket URL); asset URLs = {S3_PUBLIC_URL}/{key}.
S3_PUBLIC_URL="http://localhost:9000/portfolio"
S3_FORCE_PATH_STYLE="true"
# Maximum size of a single upload in MB (before optimization).
UPLOAD_MAX_MB="15"

# --- Payments ----------------------------------------------------------------
# mock   - built-in test checkout and customer portal pages (no keys; refused in production)
# stripe - Stripe Billing (Checkout, Customer Portal, webhooks)
PAYMENTS_PROVIDER="mock"
# Stripe secret key (sk_test_... / sk_live_...).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint {APP_PROTOCOL}://app.{ROOT_DOMAIN}/api/webhooks/stripe (whsec_...).
# Locally: `stripe listen --forward-to http://app.localhost:3000/api/webhooks/stripe` prints it.
STRIPE_WEBHOOK_SECRET=""
# Verification of EU VAT ids in billing profiles: mock (format/checksum only) or vies (EU VIES REST API, no key).
TAX_ID_PROVIDER="mock"

# --- Invoicing ---------------------------------------------------------------
# mock        - invoice PDFs generated locally, KSeF simulated (refused in production)
# fakturownia - Fakturownia API; invoices are sent to KSeF by Fakturownia
INVOICING_PROVIDER="mock"
# Fakturownia account domain ("mojafirma" for mojafirma.fakturownia.pl) and API token (Settings -> API).
FAKTUROWNIA_DOMAIN=""
FAKTUROWNIA_API_TOKEN=""
# Optional department id (Settings -> Company data; seller data and numbering of that department).
FAKTUROWNIA_DEPARTMENT_ID=""
# Send each invoice to KSeF on creation (requires KSeF connected in Fakturownia).
FAKTUROWNIA_KSEF="true"

# --- Custom domains ----------------------------------------------------------
# mock       - simulated DNS/SSL verification (a domain becomes active on the next check; refused in production)
# cloudflare - Cloudflare for SaaS custom hostnames (zone of ROOT_DOMAIN with a fallback origin)
HOSTNAME_PROVIDER="mock"
# API token with "SSL and Certificates: Edit" on the zone, and the zone id.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
# Target clients point their CNAME at (proxied record pointing to the fallback origin). Empty = sites.{ROOT_DOMAIN}.
CUSTOM_DOMAIN_CNAME_TARGET=""
# Optional comma-separated IPv4 addresses for apex domains (Cloudflare apex proxying). Empty = apex domains need
# CNAME flattening/ALIAS at the client's DNS provider (instructions say so).
CUSTOM_DOMAIN_APEX_IPS=""

# --- Domain registration -----------------------------------------------------
# mock         - simulated availability, prices and registration (refused in production)
# openprovider - Openprovider reseller API (REST v1beta)
REGISTRAR_PROVIDER="mock"
OPENPROVIDER_USERNAME=""
OPENPROVIDER_PASSWORD=""
OPENPROVIDER_API_URL="https://api.openprovider.eu/v1beta"
# Name servers set on purchased domains (zones are created in Openprovider DNS).
OPENPROVIDER_NAMESERVERS="ns1.openprovider.nl,ns2.openprovider.be,ns3.openprovider.eu"

# --- Background jobs ---------------------------------------------------------
# Jobs run in a separate process: `pnpm worker` (BullMQ on REDIS_URL).
# Base URL of the web app as reachable from the worker, used for cache invalidation
# (e.g. http://web:3000 inside Docker). Empty = the public app URL.
INTERNAL_APP_URL=""
# Template thumbnails: mock = generated placeholder image (no browser needed; refused in production),
# playwright = screenshot of the template preview (requires a Chromium; `pnpm exec playwright install chromium`).
THUMBNAIL_PROVIDER="mock"
# Optional path to an existing Chromium binary for the playwright renderer.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=""
# Optional port for the worker health check (GET /health returns 200), e.g. for Coolify/Docker.
WORKER_HEALTH_PORT=""

# --- Seed --------------------------------------------------------------------
# Password for seeded users (default: Password123!). Required when seeding production.
SEED_PASSWORD=""
